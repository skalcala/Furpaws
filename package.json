{
  "name": "furpaws-website",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "concurrently -k -n API,React \"npm:start:server\" \"npm:start:client\"",
    "start:server": "npm --workspace server start",
    "start:client": "npm --workspace client start",
    "start:production": "npm --workspace server run start:production",
    "build": "npm --workspace client run build",
    "seed": "npm --workspace server run seed",
    "db:start": "node scripts/local-db.js",
    "test": "node --test tests/*.test.js",
    "test:postman": "newman run tests/FurPaws.postman_collection.json --env-var baseUrl=http://127.0.0.1:4000/api",
    "test:browser": "node tests/ui-workflow.cjs",
    "test:revision": "node tests/ui-workflow.cjs",
    "demo": "node scripts/demo.js",
    "test:workflow": "node scripts/test-workflow.cjs",
    "test:ui:workflow": "node tests/ui-workflow.cjs",
    "test:ui:portal": "node tests/portal-browser.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "newman": "^6.2.1",
    "playwright": "^1.55.0"
  },
  "overrides": {
    "react-refresh": "0.11.0"
  },
  "engines": {
    "node": "22.x"
  }
}
