MONGODB_URI=mongodb://127.0.0.1:27018/furpaws?replicaSet=rs0
# To share live records, replace MONGODB_URI with the exact Atlas URI used in Vercel.
# Keep demo and automated tests on this separate local database server.
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27018/furpaws?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
PORT=4000
CLIENT_ORIGIN=http://127.0.0.1:3000
# Optional: real mobile verification via Twilio Verify (server only)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA...

# Email OTP and password reset (required for new registrations and email changes).
# Use SMTP credentials from your email provider; never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FurPaws <no-reply@your-verified-domain.com>
